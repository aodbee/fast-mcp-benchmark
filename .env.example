# ==============================================================================
# Fast-MCP Benchmark Configuration (.env)
# Copy this file to .env and configure your preferred LLM provider.
# Command: cp .env.example .env
# ==============================================================================

# LLM Provider selection: "gemini" | "openai" | "anthropic" | "openrouter" | "ollama" | "mock"
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Option 1: Google Gemini API (Recommended for ultra-fast live benchmarking)
# Get key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Alternative models: gemini-3.7-flash, gemini-3.6-flash, gemini-flash-latest

# ------------------------------------------------------------------------------
# Option 2: OpenAI API or University AI Gateway (UP / KKU AI Gateway)
# OpenAI compatible endpoint: works with official OpenAI, local vLLM, or campus proxies
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_or_gateway_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# # For UP / KKU Gateway: https://gen.ai.kku.ac.th/upacth/api/v1
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Option 3: Anthropic Claude API
# Get key: https://console.anthropic.com/
# ------------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# Option 4: OpenRouter API
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# Option 5: Local Ollama / vLLM
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# General Benchmark Settings
# ------------------------------------------------------------------------------
MAX_TOKENS=4096
TEMPERATURE=0.0
REQUEST_TIMEOUT_SECONDS=30
